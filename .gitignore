node_modules/

# Keep project notes, changelogs, and Codex instructions local.
# The root README remains public.
*.md
!/README.md
/docs/
/changelog/
/change_log/

# Local development work and generated reports.
/work/
/tests/
/scripts/
/outputs/
/.tmp/
/buildapk.sh

# Native IDE settings and sample tests are not needed to package the app.
/android/.idea/
/android/app/src/androidTest/
/android/app/src/test/

.agents/
.codex/

.env
.env.local

.vscode/
.preview-profile/

*.log

android/.gradle/
android/app/build/
android/build/

.DS_Store
Thumbs.db

# Generated web output: build locally, do not version hashed bundles.
/dist/

# Blender authoring files stay local; ship only Phaser runtime exports.
/assets/blender/*
!/assets/blender/the_slime_cave/
/assets/blender/the_slime_cave/*
!/assets/blender/the_slime_cave/export_phaser_stills.py
*.blend1
*.blend2

# Imported modeling sources and visual references (already embedded in Blender).
/assets/*.glb
/assets/mrglmrglmrghl_*.png
/assets/screenshot*.png
/assets/environments/slime-cave/layer-check.png

# Local conversation attachments
/.codex-remote-attachments/
